{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "declarationDir": "types",
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/index.ts", "src/**/*.ts"],
  "exclude": ["types", "test", "dist", "node_modules", "tmp"],
  "ts-node": {
    "esm": true
  },
  "tsc-alias": {
    "resolveFullPaths": true,
    "verbose": false
  }
}
